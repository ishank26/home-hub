#!/usr/bin/env python3
"""Check full staged blobs, allowing explicitly reviewed fonts and generated phone icons.

No suspected values are printed. Unknown binaries, symlinks and runtime/secret
paths are rejected. Font allowances are content-addressed, not extension-based.
"""
import argparse
import hashlib
import re
import subprocess
import sys

FONT_HASHES = {
    'static/fonts/AtkinsonHyperlegible-Regular.woff2': '00c0d7ccbca6f4e1d97be90a7ff700a49adb5a8fb146c6375a2b14c2ab0bf217',
    'static/fonts/AtkinsonHyperlegible-Bold.woff2': '6a5aaacdfeef2cabbf3e97c0e2bdbae8624e9c7a8eaf775024e7cf5b9d6c2cc2',
    'static/fonts/Fraunces-Italic-400.woff2': '69306dd6409e5d86f6c4fcc2648c02c99ec6ea21218ac0889e560eb5c7541841',
}
PHONE_ICON_HASHES = {'static/phone/icon-192.png': '95408730fcd80a48fcb7475ce5620a3472dba23bd02160e176c7641c6ce75c5f', 'static/phone/icon-512.png': 'eb8c947f07055bf5e7aa5c9249655870d58cd37bdb78ba1250a4506d71cbcb08'}
SENSITIVE_PATH = re.compile(
    r'(^|/)(?:data|backups|diagnostics|node_modules|test-results|__pycache__)(?:/|$)|'
    r'(^|/)(?:\.env(?:\.|$)|id_(?:rsa|dsa|ecdsa|ed25519)(?:\.|$)|'
    r'authorized_keys$|secrets?\.(?:json|ya?ml)$|.*credentials.*|'
    r'.*\.(?:sqlite3?|db|apk|img|bin|jks|keystore|cookies?|pem|key|p12|pfx)$|'
    r'auth\.json$|.*session.*\.json$|device-token$|config\.local\.json$)', re.I)
CONTENT_RULES = (
    re.compile(r"-----BEGIN PGP (?:PRIVATE) KEY BLOCK-----"),
    re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}"),
    re.compile(r"\b[a-z]{4}(?:-[a-z]{4}){3}\b"),
    re.compile(r"https?://[^\s/:]+:[^\s/@]+@"),
    re.compile(r'-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----'),
    re.compile(r'\bAGE-SECRET-KEY-1[0-9A-Z]{10,}\b'),
    re.compile(r'\bgh[pousr]_[A-Za-z0-9]{30,}\b'),
    re.compile(r'\bgithub_pat_[A-Za-z0-9_]{40,}\b'),
    re.compile(r'\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{24,}\b'),
    re.compile(r'\bAKIA[A-Z0-9]{16}\b'),
    re.compile(r'\b\d{7,12}:[A-Za-z0-9_-]{30,}\b'),
    re.compile(r'''(?i)\b(?:api[_-]?key|access[_-]?token|refresh[_-]?token|bot[_-]?token|auth[_-]?token|homeassistant[_-]?token|device[_-]?token|token|password|client[_-]?secret)["']?\s*[:=]\s*(["'])([^\r\n"']{16,})\1'''),
    re.compile(r'''(?mi)^\s*(?:export\s+)?(?:api[_-]?key|access[_-]?token|refresh[_-]?token|bot[_-]?token|auth[_-]?token|homeassistant[_-]?token|device[_-]?token|token|password|client[_-]?secret)\s*=\s*([A-Za-z0-9_./+!@$%^&*?\-=]{16,})(?:\s+#[^\r\n]*)?\s*$'''),
)


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, check=True).stdout


def scan_blob(name, data):
    if name in PHONE_ICON_HASHES:
        if hashlib.sha256(data).hexdigest() != PHONE_ICON_HASHES[name] or not data.startswith(b'\x89PNG\r\n\x1a\n'):
            return 'reviewed phone icon hash mismatch'
        return None
    if name in FONT_HASHES:
        if hashlib.sha256(data).hexdigest() != FONT_HASHES[name] or not data.startswith(b'wOF2'):
            return 'reviewed font hash mismatch'
        return None
    if SENSITIVE_PATH.search(name):
        return 'runtime/secret-like path'
    if len(data) > 2 * 1024 * 1024:
        return 'oversized artifact'
    try:
        text = data.decode('utf-8')
    except UnicodeDecodeError:
        return 'unreviewed binary'
    for rule in CONTENT_RULES:
        if rule.search(text):
            return 'secret-looking content'
    return None


def check_entry(name, mode, data):
    if mode not in ('100644', '100755'):
        raise ValueError('non-regular Git file (path suppressed)')
    reason = scan_blob(name, data)
    if reason:
        raise ValueError(reason + ' (value and path suppressed)')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--all-history', action='store_true', help='scan all reachable commits and metadata')
    parser.add_argument('--all-index', action='store_true', help='scan the full index, not just staged changes')
    args = parser.parse_args()
    git('diff', '--check')
    git('diff', '--cached', '--check')
    count = 0
    if args.all_index:
        names = {n for n in git('ls-files', '-z').split(b'\0') if n}
    else:
        names = {n for n in git('diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z').split(b'\0') if n}
    for encoded in sorted(names):
        name = encoded.decode('utf-8')
        mode = git('ls-files', '--stage', '--', name).decode().split(' ', 1)[0]
        check_entry(name, mode, git('show', ':' + name))
        count += 1
    history_count = 0
    if args.all_history:
        seen = set()
        for commit in git('rev-list', '--all').decode().splitlines():
            for entry in git('ls-tree', '-r', '-z', commit).split(b'\0'):
                if not entry or entry in seen:
                    continue
                seen.add(entry)
                info, name = entry.split(b'\t', 1)
                mode, kind, oid = info.decode().split()
                if kind != 'blob':
                    raise ValueError('non-blob history entry (path suppressed)')
                check_entry(name.decode(), mode, git('cat-file', 'blob', oid))
                history_count += 1
        metadata = git('log', '--all', '--format=fuller') + git('for-each-ref', '--format=%(contents)', 'refs/tags')
        reason = scan_blob('commit-metadata.txt', metadata)
        if reason:
            raise ValueError(reason + ' in metadata (value suppressed)')
    print(f'Repository safety scan passed ({count} index files, {history_count} historical file versions).')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        # Git errors may contain private paths; never echo their captured output.
        print('check-repo-safety: validation refused' if isinstance(error, subprocess.CalledProcessError) else f'check-repo-safety: {error}', file=sys.stderr)
        raise SystemExit(1)
